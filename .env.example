# Firebase web-app configuration (Firebase Console → Project settings → Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS browser configuration. These are public identifiers, not private API keys.
# Set the notification recipient inside the EmailJS template/dashboard.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# The only Firebase account allowed into the website's admin area.
VITE_ADMIN_EMAIL=

